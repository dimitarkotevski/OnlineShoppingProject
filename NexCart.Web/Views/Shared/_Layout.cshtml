@inject NexCart.Web.Infrastructure.SpaAssets Spa
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShoppingDev</title>
    <base href="/" />

    @if (!string.IsNullOrEmpty(Spa.Styles))
    {
        <link rel="stylesheet" href="@Spa.Styles" />
    }
</head>
<body>
    @RenderBody()

    @if (!string.IsNullOrEmpty(Spa.Polyfills))
    {
        <script src="@Spa.Polyfills"></script>
    }
    @if (!string.IsNullOrEmpty(Spa.Scripts))
    {
        <script src="@Spa.Scripts"></script>
    }
    @if (!string.IsNullOrEmpty(Spa.Main))
    {
        <script src="@Spa.Main"></script>
    }
</body>
</html>
