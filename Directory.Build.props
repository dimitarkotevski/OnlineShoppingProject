<Project>

  <!-- Settings shared by every project in the solution. Values that differ per project
       (OutputType, RootNamespace, AssemblyName, package and project references) stay in
       the individual .csproj files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Each project ships a hand-written Properties/AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
