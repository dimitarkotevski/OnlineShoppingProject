<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>IntellaQuest.Web</RootNamespace>
    <AssemblyName>IntellaQuest.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IntellaQuest.BusinessLogic\IntellaQuest.BusinessLogic.csproj" />
    <ProjectReference Include="..\IntellaQuest.Domain\IntellaQuest.Domain.csproj" />
    <ProjectReference Include="..\IntellaQuest.Data.NHibernate\IntellaQuest.Data.NHibernate.csproj" />
  </ItemGroup>

  <!-- The Angular workspace is built with the Angular CLI, not MSBuild. Keep it out of the
       compile/content item lists so node_modules and the build output are not treated as content. -->
  <ItemGroup>
    <Compile Remove="my-app\**" />
    <Content Remove="my-app\**" />
    <None Remove="my-app\**" />
  </ItemGroup>

</Project>
