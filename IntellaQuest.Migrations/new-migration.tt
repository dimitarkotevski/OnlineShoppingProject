<#@ template language="C#" hostspecific="true" #>
<#@ output extension=".txt" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Diagnostics" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#
    // ---------------------------------------------------------------------------
    // new-migration.tt - scaffolds a FluentMigrator migration.
    //
    // Run it from Visual Studio: select this file and press Ctrl+Shift+P
    // ("Run Custom Tool"), or right-click it -> Run Custom Tool.
    //
    // It creates one folder per migration:
    //
    //     Migrations\<version>\<timestamp>_<gitUser>\
    //         1_class.cs      the FluentMigrator migration class
    //         up.sql          CREATE   (run by "up")
    //         down.sql        REMOVE   (run by "down")
    //
    // <version>   comes from appsettings.json ("Migrations:Version").
    // <gitUser>   is `git config user.name` (falls back to the Windows user).
    // <timestamp> is the UTC time, yyyyMMddHHmmss; taken stamps are bumped a second.
    //
    // The runner finds the class automatically - no registration is needed, and in
    // an SDK-style project the new files are picked up without touching the .csproj.
    // ---------------------------------------------------------------------------

    string projectDir = Path.GetDirectoryName(Path.GetFullPath(Host.TemplateFile));
    string migrationsDir = Path.Combine(projectDir, "Migrations");

    string version = ReadVersion(projectDir);
    string gitUser = SafeToken(GetGitUserName(projectDir));

    string versionDir = Path.Combine(migrationsDir, version);
    Directory.CreateDirectory(versionDir);

    // One migration per second; keep bumping until the timestamp is free.
    string timestamp = DateTime.UtcNow.ToString("yyyyMMddHHmmss", CultureInfo.InvariantCulture);
    while (Directory.GetDirectories(versionDir, timestamp + "_*").Length > 0)
    {
        timestamp = DateTime.ParseExact(timestamp, "yyyyMMddHHmmss", CultureInfo.InvariantCulture)
            .AddSeconds(1)
            .ToString("yyyyMMddHHmmss", CultureInfo.InvariantCulture);
    }

    string id = timestamp + "_" + gitUser;
    string folder = Path.Combine(versionDir, id);
    Directory.CreateDirectory(folder);

    // Path the generated class passes to Execute.Script (relative to the app dir).
    string scriptFolder = "Migrations\\" + version + "\\" + id;

    var utf8 = new UTF8Encoding(false);
    File.WriteAllText(Path.Combine(folder, "1_class.cs"), ClassContent(id, timestamp, scriptFolder), utf8);
    File.WriteAllText(Path.Combine(folder, "up.sql"), UpContent(id), utf8);
    File.WriteAllText(Path.Combine(folder, "down.sql"), DownContent(id), utf8);
#>
Scaffolded migration <#= id #>:
    Migrations\<#= version #>\<#= id #>\1_class.cs
    Migrations\<#= version #>\<#= id #>\up.sql
    Migrations\<#= version #>\<#= id #>\down.sql

This file itself is only the template's output and is not used.
<#+
    // Version folder, read from appsettings.json. Keep it in sync by hand.
    private string ReadVersion(string projectDir)
    {
        string path = Path.Combine(projectDir, "appsettings.json");
        if (File.Exists(path))
        {
            var match = Regex.Match(File.ReadAllText(path), "\"Version\"\\s*:\\s*\"([^\"]+)\"");
            if (match.Success)
            {
                return match.Groups[1].Value;
            }
        }
        return "0.0.0.1";
    }

    // The migration author, e.g. "kotev". Falls back to the Windows user name.
    private string GetGitUserName(string workingDirectory)
    {
        try
        {
            var startInfo = new ProcessStartInfo("git", "config user.name")
            {
                WorkingDirectory = workingDirectory,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using (var process = Process.Start(startInfo))
            {
                string output = process.StandardOutput.ReadToEnd().Trim();
                process.WaitForExit();
                if (process.ExitCode == 0 && output.Length > 0)
                {
                    return output;
                }
            }
        }
        catch
        {
            // git is not installed or not on PATH - fall through.
        }

        return Environment.UserName;
    }

    // A folder/identifier-safe token: letters and digits, everything else -> "_".
    private string SafeToken(string value)
    {
        var builder = new StringBuilder();
        foreach (char c in value)
        {
            builder.Append(char.IsLetterOrDigit(c) ? c : '_');
        }

        string token = builder.ToString().Trim('_');
        return token.Length == 0 ? "user" : token;
    }

    private string ClassContent(string id, string timestamp, string scriptFolder)
    {
        return string.Format(@"using FluentMigrator;

namespace IntellaQuest.Migrations
{{
    /// <summary>
    /// Migration {0}.
    /// up.sql   - create
    /// down.sql - remove
    /// </summary>
    [Migration({1}, ""{0}"")]
    public sealed class Migration_{0} : Migration
    {{
        public override void Up()
        {{
            Execute.Script(@""{2}\up.sql"");
        }}

        public override void Down()
        {{
            Execute.Script(@""{2}\down.sql"");
        }}
    }}
}}", id, timestamp, scriptFolder);
    }

    private string UpContent(string id)
    {
        return string.Format(@"-- Migration {0}  (up = create)
-- Applied by:  dotnet run --project IntellaQuest.Migrations
--
-- Add the CREATE statements below. Separate batches with a line containing GO.
", id);
    }

    private string DownContent(string id)
    {
        return string.Format(@"-- Migration {0}  (down = remove)
-- Applied by:  dotnet run --project IntellaQuest.Migrations -- down
--
-- Add the DROP/undo statements below. Separate batches with a line containing GO.
", id);
    }
#>
